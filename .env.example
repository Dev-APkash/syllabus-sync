# Copy this file to .env.local and fill in real values. Fake values only here: this file IS committed.
# See PLAN.md section 2.3 for where each value comes from.

# Supabase (self-hosted, PLAN.md Phase H)
NEXT_PUBLIC_SUPABASE_URL=https://dev-api.example.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
SUPABASE_DB_URL=postgresql://<user>:<password>@<server's Tailscale name>:5432/postgres

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# App settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MAX_EXTRACTIONS_PER_DAY=10
EXTRACTION_ENABLED=true
# Encrypts linked Canvas tokens: 64 hex characters, e.g. from `openssl rand -hex 32`. Empty = Canvas off.
CANVAS_TOKEN_KEY=

# Two test accounts for `npm run check:rls` (PLAN.md Task 2.6). Laptop only, never Vercel.
TEST_USER_A_EMAIL=student-a@example.com
TEST_USER_A_PASSWORD=xxxxxxxx
TEST_USER_B_EMAIL=student-b@example.com
TEST_USER_B_PASSWORD=xxxxxxxx
