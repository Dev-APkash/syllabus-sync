# What selfhost/.env looks like. Don't copy this by hand: run `bash setup.sh`, which writes the
# real .env with fresh random secrets. Fake values only here; this file IS committed.

SITE_URL=https://syllabus.example-tailnet.ts.net
APP_BIND=127.0.0.1
APP_PORT=8080
APP_IMAGE=ghcr.io/dev-apkash/syllabus-sync:0.1

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5
MAX_EXTRACTIONS_PER_DAY=10
EXTRACTION_ENABLED=true

DISABLE_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Syllabus Sync

POSTGRES_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANON_KEY=xxxxx.anon-jwt.xxxxx
SERVICE_ROLE_KEY=xxxxx.service-role-jwt.xxxxx
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PG_META_CRYPTO_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_PROTOCOL_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_PROTOCOL_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CANVAS_TOKEN_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
